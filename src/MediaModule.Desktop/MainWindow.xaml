                                </Grid>
                                <TextBlock Text="Структура каталогов: [Root]\[ClientName]\[ProductType]\" Foreground="{StaticResource Green}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Правила проверки" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
