                                    <Border Grid.Column="1" Width="30" Height="30" Background="{StaticResource Accent}" CornerRadius="6" HorizontalAlignment="Right">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
