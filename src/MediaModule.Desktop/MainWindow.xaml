                                    <Border BorderBrush="{StaticResource Red}" BorderThickness="3,0,0,0" Padding="10,0,0,0" Margin="0,2,0,14">
                                        <TextBlock x:Name="SearchSelectedMessageTextBlock" Text="" TextWrapping="Wrap" LineHeight="18" />
                                    </Border>
                                    <TextBlock Text="Теги" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="SearchSelectedTagsTextBlock" Text="Нет тегов" TextWrapping="Wrap" Visibility="Collapsed" />
