                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Путь" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding FilePath}" Style="{StaticResource JournalTextStyle}" Margin="12,0" ToolTip="{Binding FilePath}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Статус" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Status}" Style="{StaticResource JournalTextStyle}" Margin="12,0" ToolTip="{Binding Status}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
