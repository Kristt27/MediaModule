                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding OperationTimeDisplay}" Style="{StaticResource DashboardTextStyle}" Margin="12,0" ToolTip="{Binding OperationTimeUtc}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Созданные теги" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
