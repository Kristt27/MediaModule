                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="14"><StackPanel><DockPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="15" DockPanel.Dock="Left" /><TextBlock Text="ivanov_banner_1.jpg" FontSize="12" Margin="10,0,0,0" Style="{StaticResource CompactFileNameTextStyle}" /></DockPanel><TextBlock Text="14 GB" Style="{StaticResource MutedText}" Margin="0,12,0,14" /><TextBlock Text="Открыть детали" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="14"><StackPanel><DockPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="15" DockPanel.Dock="Left" /><TextBlock Text="volkov_vizitka_2026_2.png" FontSize="12" Margin="10,0,0,0" Style="{StaticResource CompactFileNameTextStyle}" /></DockPanel><TextBlock Text="20 GB" Style="{StaticResource MutedText}" Margin="0,12,0,14" /><TextBlock Text="Открыть детали" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="14"><StackPanel><DockPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="15" DockPanel.Dock="Left" /><TextBlock Text="noskov_plakat_2026.svg" FontSize="12" Margin="10,0,0,0" Style="{StaticResource CompactFileNameTextStyle}" /></DockPanel><TextBlock Text="1 GB" Style="{StaticResource MutedText}" Margin="0,12,0,14" /><TextBlock Text="Открыть детали" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="14"><StackPanel><DockPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="15" DockPanel.Dock="Left" /><TextBlock Text="zdrava_banner_2026.svg" FontSize="12" Margin="10,0,0,0" Style="{StaticResource CompactFileNameTextStyle}" /></DockPanel><TextBlock Text="15 GB" Style="{StaticResource MutedText}" Margin="0,12,0,14" /><TextBlock Text="Открыть детали" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Border>
