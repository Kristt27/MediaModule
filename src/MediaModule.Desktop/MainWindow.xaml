                                    <Border Grid.Column="1" Width="30" Height="30" Background="{StaticResource Green}" CornerRadius="6" HorizontalAlignment="Right">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="14">
                                <Grid>
