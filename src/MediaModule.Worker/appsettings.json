{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/module-.log",
          "rollingInterval": "Day",
          "shared": true,
          "flushToDiskInterval": "00:00:02"
        }
      }
    ]
  },
  "Module": {
    "RootDirectory": "demo\\Design",
    "MonitoredDirectories": [
      "C:\\Users\\Кристина\\Desktop\\test-media"
    ],
    "IgnoredDirectories": [
      "%USERPROFILE%\\AppData",
      "%USERPROFILE%\\.nuget",
      "%USERPROFILE%\\.dotnet",
      "%USERPROFILE%\\source\\repos"
    ],
    "IncludeSubdirectories": true,
    "EventDebounceMilliseconds": 1200,
    "FileNameRegexPattern": "^[\\p{L}0-9]+_[\\p{L}0-9]+_20\\d{2}_\\d+\\.[A-Za-z0-9]+$",
    "ValidateFileName": true,
    "ValidatePath": true,
    "DetectDuplicates": true,
    "DuplicateHashDistanceThreshold": 5,
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tif", ".tiff" ],
    "RollbackBlockedFiles": false,
    "RejectedFilesDirectory": "rejected",
    "AutoAcceptTags": false,
    "DatabasePath": "data/module.db",
